# Copy to .env and fill in:  cp .env.example .env
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local Homebrew Postgres runs on 5433 here
# (an EnterpriseDB Postgres already uses 5432 on this machine).
DATABASE_URL=postgresql://USER@localhost:5433/portfolio_dev
# Used only by `npm test`; it gets wiped on every test run.
TEST_DATABASE_URL=postgresql://USER@localhost:5433/portfolio_test

# Browser origins allowed to call the API (the site and the admin panel).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public site, used for the portfolio link on the resume and for cache refresh.
PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Long random string shared with the frontend (generate: openssl rand -hex 32).
REVALIDATE_SECRET=change-me

# Salt for hashing contact-form IP addresses (generate: openssl rand -hex 16).
IP_HASH_SALT=change-me

# Where uploads and generated resumes are stored. Use a persistent disk in production.
STORAGE_DIR=./storage

# Chrome/Chromium used to render resume PDFs.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# true in production (HTTPS only cookies).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs).
TRUST_PROXY=1
