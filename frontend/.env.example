# Copy to .env.local for local development: cp .env.example .env.local
# Only variables prefixed NEXT_PUBLIC_ reach the browser.

# Public base URL, used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Express API runs (server-side only).
BACKEND_URL=http://localhost:4000

# Shared with backend/.env REVALIDATE_SECRET. Lets the API refresh this site's
# cache on publish, and lets this server read drafts in preview mode.
REVALIDATE_SECRET=change-me
